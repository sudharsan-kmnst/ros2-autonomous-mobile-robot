<?xml version="1.0"?>
<!--
  robot_core.xacro
  The physical robot: frames + links + joints.

  FRAME CONVENTION (this is the part interviewers probe):
    base_footprint  -> ground-projection frame, sits on the floor (z=0 at ground).
                       Nav2 / SLAM plan in 2D relative to this.
    base_link       -> rigid body frame at the DRIVE AXLE, 0.05 m up (= wheel radius).
                       Putting base_link on the axle midpoint makes differential-drive
                       odometry exact (the point that doesn't translate when you spin).
    left/right wheel-> continuous joints spun by the DiffDrive plugin.
    caster          -> passive sphere, low friction, gives the 3rd contact point.

  KEY NUMBERS (must match the DiffDrive plugin in gazebo_control.xacro):
    wheel_radius     = 0.05 m
    wheel_separation = 0.35 m  (wheels at y = +/-0.175)
  Get these wrong and odometry drifts (Day 1 gotcha in your plan).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="inertial_macros.xacro"/>

  <!-- ================= Materials (RViz colors) ================= -->
  <material name="white"><color rgba="1 1 1 1"/></material>
  <material name="orange"><color rgba="1 0.3 0.1 1"/></material>
  <material name="blue"><color rgba="0.2 0.2 1 1"/></material>
  <material name="black"><color rgba="0 0 0 1"/></material>

  <!-- ================= base_footprint (root) ================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child  link="base_link"/>
    <!-- base_link is one wheel-radius above the ground -->
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
  </joint>

  <!-- ================= base_link (drive axle) ================= -->
  <link name="base_link"/>

  <!-- ================= Chassis ================= -->
  <joint name="chassis_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="chassis"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="chassis">
    <!-- box 0.3(x) x 0.3(y) x 0.15(z), bottom flush with axle height -->
    <visual>
      <origin xyz="0.075 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.3 0.3 0.15"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.075 0 0.075" rpy="0 0 0"/>
      <geometry><box size="0.3 0.3 0.15"/></geometry>
    </collision>
    <xacro:inertial_box mass="0.5" l="0.3" w="0.3" h="0.15">
      <origin xyz="0.075 0 0.075" rpy="0 0 0"/>
    </xacro:inertial_box>
  </link>

  <!-- ================= Left drive wheel ================= -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="left_wheel"/>
    <!-- +Y side; rotate cylinder so its axis points along the wheel axle -->
    <origin xyz="0 0.175 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="left_wheel">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ================= Right drive wheel ================= -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child  link="right_wheel"/>
    <origin xyz="0 -0.175 0" rpy="1.5708 0 0"/>
    <axis xyz="0 0 -1"/>
  </joint>

  <link name="right_wheel">
    <visual>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.04"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.1" length="0.04" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ================= Caster wheel (passive) ================= -->
  <joint name="caster_wheel_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="caster_wheel"/>
    <!-- front of the robot, sphere center at axle height so it touches the floor -->
    <origin xyz="0.12 0 0" rpy="0 0 0"/>
  </joint>

  <link name="caster_wheel">
    <visual>
      <geometry><sphere radius="0.05"/></geometry>
      <material name="white"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.05"/></geometry>
    </collision>
    <xacro:inertial_sphere mass="0.05" radius="0.05">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_sphere>
  </link>

  <!-- Gazebo - make the caster frictionless so it slides like a ball caster -->
  <gazebo reference="caster_wheel">
    <mu1 value="0.001"/>
    <mu2 value="0.001"/>
  </gazebo>

</robot>
