<?xml version="1.0"?>
<!--
  gazebo_control.xacro
  The Gazebo Harmonic DiffDrive SYSTEM plugin. This is the Day 1 gotcha from your plan:
  on Harmonic the plugin is gz::sim::systems::DiffDrive (filename gz-sim-diff-drive-system),
  NOT the old Gazebo-Classic libgazebo_ros_diff_drive.

  What it does: reads a Twist on /cmd_vel, spins the two wheel joints, integrates wheel
  encoders into odometry, and publishes odom + the odom->base_link TF. That TF is the
  bottom of your map->odom->base_link chain (SLAM supplies map->odom on top).

  wheel_separation / wheel_radius MUST match robot_core.xacro exactly, or the integrated
  odometry scales wrong and drifts.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <!-- joints to drive -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- kinematics - keep in sync with robot_core.xacro -->
      <wheel_separation>0.35</wheel_separation>
      <wheel_radius>0.05</wheel_radius>

      <!-- limits (tune later on Day 5) -->
      <max_linear_acceleration>1.0</max_linear_acceleration>

      <!-- topics + frames -->
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <!-- Publishes joint positions/velocities so wheel TFs move in RViz -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
