<?xml version="1.0"?>
<!--
  lidar.xacro
  A 2D lidar link on top of the chassis + the Gazebo gpu_lidar sensor.

  WHY the frame name matters: slam_toolbox and Nav2 subscribe to /scan and look up
  the transform for the scan's frame_id. The <gz_frame_id> below MUST equal this
  link name (lidar_link), and the ros_gz_bridge (Day 2) must carry that frame through.
  Mismatch here = "message filter dropping message" spam and no map (your Day 2 gotcha).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <joint name="lidar_joint" type="fixed">
    <parent link="chassis"/>
    <child  link="lidar_link"/>
    <!-- centered on chassis, on top (chassis top = z 0.15) + small standoff -->
    <origin xyz="0 0 0.175" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.04"/></geometry>
    </collision>
    <xacro:inertial_cylinder mass="0.05" length="0.04" radius="0.04">
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:inertial_cylinder>
  </link>

  <!-- ============ Gazebo Harmonic GPU lidar sensor ============ -->
  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.141592</min_angle>
            <max_angle>3.141592</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
      <always_on>1</always_on>
      <visualize>true</visualize>
    </sensor>
  </gazebo>

</robot>
